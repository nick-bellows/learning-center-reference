# Copy to .env and fill in local values. NEVER commit .env.
# NEVER put real member, player, or employer data anywhere in this project.

# --- Postgres (local dev) ---
POSTGRES_USER=lcr
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=lcr
# The API reads this. Host is "db" inside compose, "localhost" if you run the API on your machine.
DATABASE_URL=postgres://lcr:change-me-locally@db:5432/lcr?sslmode=disable

# --- Auth0 (OIDC) — create a free tenant at auth0.com ---
# The Go API verifies incoming tokens against the tenant's JWKS using DOMAIN + AUDIENCE.
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_AUDIENCE=https://api.learning-center-reference.local

# --- Web (Next.js Auth0 SDK) ---
AUTH0_SECRET=generate-a-long-random-string-openssl-rand-hex-32
AUTH0_BASE_URL=http://localhost:3000
AUTH0_ISSUER_BASE_URL=https://your-tenant.us.auth0.com
AUTH0_CLIENT_ID=from-your-auth0-application
AUTH0_CLIENT_SECRET=from-your-auth0-application
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# --- Sanity (course content) ---
SANITY_PROJECT_ID=from-sanity-manage
SANITY_DATASET=production
