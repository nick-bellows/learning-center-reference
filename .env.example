# OPTIONAL for local dev — compose.yml ships working local-only defaults, so
# a clean clone needs no .env at all. Copy this file to .env only to override.
# NEVER commit .env. NEVER put real member, player, or employer data anywhere
# in this project.

# --- Postgres (local dev overrides) ---
POSTGRES_USER=lcr
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=lcr
POSTGRES_PORT=5432
# Host is "db" inside compose, "localhost" if you run the API on your machine.
DATABASE_URL=postgres://lcr:change-me-locally@db:5432/lcr?sslmode=disable
API_PORT=8080
WEB_PORT=3000

# --- Authentication ---
# compose.yml selects the explicit local demo adapter and synthetic subjects.
AUTH_MODE=demo
DEMO_LEARNER_TOKEN=local-learner-token
DEMO_ADMIN_TOKEN=local-admin-token
# Service token for GET /v1/members/{subject}/credentials (scope credentials:read).
# Synthetic identifier for the local stack only; a real caller presents an OAuth2
# client-credentials token from the shared provider.
DEMO_SERVICE_TOKEN=local-service-token

# For Auth0 or another standards-compliant provider, the API validates the
# token signature, issuer, audience, and expiry, then loads roles from Postgres.
# AUTH_MODE=oidc
# OIDC_ISSUER_URL=https://example.us.auth0.com/
# OIDC_AUDIENCE=https://learning-center.example/api

# --- Planned CMS integration ---
# SANITY_PROJECT_ID=
# SANITY_DATASET=production
