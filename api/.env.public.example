# Deployment template only. Never commit the populated values.
DEPLOYMENT_ENV=public
AUTH_MODE=oidc
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
OIDC_ISSUER_URL=https://YOUR_TENANT.example.com/
OIDC_AUDIENCE=https://learning-center-api.example
MIGRATE_ON_START=1
RATE_LIMIT_PER_MINUTE=120
# Set to 1 only when exactly one trusted proxy sits in front of the service. The rate
# limiter then keys on the rightmost X-Forwarded-For entry (the address that proxy observed),
# which a client cannot spoof by prepending its own entries. Leave 0 otherwise.
TRUST_PROXY=0
