# Deployment template only. Never commit the populated values.
DEPLOYMENT_ENV=public
AUTH_MODE=oidc
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
OIDC_ISSUER_URL=https://YOUR_TENANT.example.com/
OIDC_AUDIENCE=https://learning-center-api.example
MIGRATE_ON_START=1
RATE_LIMIT_PER_MINUTE=120
# Set to 1 only when the service is behind a trusted proxy that replaces X-Forwarded-For.
TRUST_PROXY=0
