# Deployment template only. Never commit the populated values.
DEPLOYMENT_ENV=public
AUTH_MODE=oidc
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
OIDC_ISSUER_URL=https://YOUR_TENANT.example.com/
OIDC_AUDIENCE=https://learning-center-api.example
MIGRATE_ON_START=1
# Least-privilege request handling (required in public mode). Either adopt the DML-only
# role from migration 0007 on the owner connection ...
DB_RUNTIME_ROLE=lcr_runtime
# ... or point request handling at a separate login role created IN ROLE lcr_runtime.
# RUNTIME_DATABASE_URL=postgresql://APP_USER:APP_PASSWORD@HOST/DATABASE?sslmode=require
RATE_LIMIT_PER_MINUTE=120
# Set to 1 only when exactly one trusted proxy sits in front of the service. The rate
# limiter then keys on the rightmost X-Forwarded-For entry (the address that proxy observed),
# which a client cannot spoof by prepending its own entries. Leave 0 otherwise.
TRUST_PROXY=0
