FROM golang:1.27-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o /out/oidcfixture ./cmd/oidcfixture

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/oidcfixture /oidcfixture
USER nonroot:nonroot
EXPOSE 5556
HEALTHCHECK --interval=2s --timeout=2s --retries=15 CMD ["/oidcfixture", "healthcheck"]
ENTRYPOINT ["/oidcfixture"]
