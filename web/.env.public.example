# Deployment template only. Never commit the populated values.
WEB_DEPLOYMENT_ENV=public
WEB_AUTH_MODE=oidc
API_BASE_URL=https://api.example.com
APP_BASE_URL=https://learning-center.example.com
OIDC_ISSUER_URL=https://YOUR_TENANT.example.com
OIDC_CLIENT_ID=replace-with-provider-client-id
OIDC_CLIENT_SECRET=replace-with-provider-client-secret
OIDC_AUDIENCE=https://learning-center-api.example
# Generate independently with at least 32 random bytes; do not reuse the OIDC client secret.
SESSION_SECRET=replace-with-a-long-random-session-secret
# Public mode always sets the Secure cookie flag; SESSION_COOKIE_SECURE=1 forces it in local mode
# when the local stack is served over HTTPS.

